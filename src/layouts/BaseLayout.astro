---
// BaseLayout.astro - Master layout for Xichi AI Neo-Brutalist Brand Website
import '../styles/global.css';
import TopTape from '../components/TopTape.astro';
import Loader from '../components/Loader.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import PreorderModal from '../components/PreorderModal.astro';
import { siteConfig } from '../data/siteConfig';
import { hardwareProducts } from '../data/products';
import { faqItems } from '../data/faqs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : 'https://produk.irsyadlabs.id/',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://produk.irsyadlabs.id';
const imageUrl = new URL(image, siteUrl).href;

// 1. JSON-LD Organization
const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Xichi AI',
  alternateName: [
    'Xichi AI Studio',
    'Xiaozhi Indonesia',
    'Xichi Voice AI Assistant',
    'Asisten AI Fisik Indonesia',
    'Xichi Studio',
  ],
  url: siteUrl,
  logo: `${siteUrl}/assets/logoxichi.jpg`,
  description: description,
  founder: {
    '@type': 'Person',
    name: 'Irsyad',
    url: 'https://github.com/Franklnir',
  },
  sameAs: [
    'https://xiaozhiscig.biz.id',
    'https://github.com/Franklnir',
    'https://instagram.com/xichiaipendant',
    'https://tiktok.com/@xichiaipendant',
    'https://youtube.com/@xichiaipendant',
  ],
};

// 2. JSON-LD WebSite
const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Xichi AI — Xiaozhi Indonesia & Voice AI Assistant',
  alternateName: [
    'Xiaozhi Indonesia',
    'Xiaozhi Indoensia',
    'Xichi AI',
    'xiaozhiscig',
    'Asisten AI Fisik',
    'Voice AI Indonesia',
  ],
  url: siteUrl,
  description: description,
  inLanguage: 'id-ID',
  publisher: {
    '@type': 'Organization',
    name: 'Xichi AI Studio',
    url: siteUrl,
  },
};

// 3. JSON-LD Product & Offers
const jsonLdProduct = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Xichi Physical AI Assistant — Xiaozhi Indonesia (ESP32-S3 / C3)',
  alternateName: [
    'Xiaozhi Indonesia Hardware',
    'Voice AI Assistant Xichi',
    'Asisten AI Fisik Xichi',
    'xiaozhiscig AI companion',
  ],
  image: hardwareProducts.map((p) => `${siteUrl}${p.image || '/assets/products/xichi-core-render.webp'}`),
  description:
    'Perangkat keras asisten AI fisik dan Voice AI Xiaozhi Indonesia dari Xichi AI Studio. Dilengkapi suara interaktif bahasa Indonesia, layar ekspresi emosi dinamis, pemutar YouTube mandiri tanpa iklan, AI vision on-device, dan IoT smart home dual relay.',
  brand: {
    '@type': 'Brand',
    name: 'Xichi AI',
  },
  keywords:
    'xiaozhi, xiaozhi indonesia, xiaozhi indoensia, ai asisten, asisten ai, voice ai, ai, xichi ai, xiaozhiscig, xichi, esp32-s3 ai',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'IDR',
    lowPrice: 300000,
    highPrice: 630000,
    offerCount: hardwareProducts.length,
    availability: 'https://schema.org/PreOrder',
    offers: hardwareProducts.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.priceValue,
      priceCurrency: 'IDR',
      availability: 'https://schema.org/PreOrder',
      url: `${siteUrl}#buy`,
    })),
  },
};

// 4. JSON-LD FAQPage
const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

// 5. JSON-LD SoftwareApplication (Chronos App)
const jsonLdApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Chronos Companion App',
  operatingSystem: 'Android',
  applicationCategory: 'SmartHomeApplication',
  downloadUrl: 'https://play.google.com/store/apps/details?id=com.fbiego.chronos',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'IDR',
  },
};

// 6. JSON-LD BreadcrumbList
const jsonLdBreadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Xichi AI',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Xiaozhi Indonesia',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Xichi Voice AI Assistant',
      item: canonicalUrl,
    },
  ],
};
---

<!doctype html>
<html lang="id" data-theme="brand">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" id="themeColor" content="#ebebeb" />
    <link rel="icon" type="image/jpeg" href="/assets/logoxichi.jpg" />
    <link rel="apple-touch-icon" href="/assets/logoxichi.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Sora, Space Grotesk, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Anton&family=Permanent+Marker&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Flash Prevention Script -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('xichi-theme');
          const theme = saved === 'dark' ? 'dark' : 'brand';
          document.documentElement.dataset.theme = theme;
          const meta = document.getElementById('themeColor');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#FFE600' : '#ebebeb');
        } catch {
          document.documentElement.dataset.theme = 'brand';
        }
      })();
    </script>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="xiaozhi, xiaozhi indonesia, xiaozhi indoensia, ai asisten, asisten ai, voice ai, ai, xichi, xichi ai, xiaozhiscig, esp32, esp32-s3, chronos app, robot meja ai, open source indonesia, voice engine ai"
    />
    <meta name="author" content="Xichi AI Studio & Komunitas Xiaozhi Indonesia" />
    <meta name="publisher" content="Xichi AI Studio" />
    <meta name="copyright" content="Xichi AI Studio" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />
    <meta name="language" content="Indonesian" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Xichi AI — Xiaozhi Indonesia & Voice AI" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdProduct)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />
  </head>
  <body>
    <!-- Hand-drawn rough animation filters from Belajar AI -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="rough"><feTurbulence type="fractalNoise" baseFrequency=".035" numOctaves="2" seed="4" result="noise"/><feDisplacementMap in="SourceGraphic" in2="noise" scale="4"/></filter>
        <filter id="rough2"><feTurbulence type="fractalNoise" baseFrequency=".035" numOctaves="2" seed="11" result="noise"/><feDisplacementMap in="SourceGraphic" in2="noise" scale="4"/></filter>
        <filter id="rough3"><feTurbulence type="fractalNoise" baseFrequency=".035" numOctaves="2" seed="23" result="noise"/><feDisplacementMap in="SourceGraphic" in2="noise" scale="4"/></filter>
      </defs>
    </svg>

    <!-- Flying Paper Airplane (Belajar AI signature motion) -->
    <svg class="plane" viewBox="0 0 60 60" aria-hidden="true">
      <path d="M4 30 56 8 42 52 28 36zM28 36 56 8" />
    </svg>

    <Loader />
    <ScrollProgress />

    <slot />

    <!-- Peek Assistant Mascot (Belajar AI style) -->
    <a href="#voice" class="peek" aria-label="Halo! Mau kenalan sama Xichi?">
      <img src="/assets/logoxichi.jpg" alt="Xichi Assistant" width="76" height="76" />
      <span>Halo! Mau ngobrol sama Xichi? 👋</span>
    </a>

    <!-- Floating WhatsApp CTA (Belajar AI style with ring & live dot) -->
    <a
      class="wa-float"
      href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Halo tim Xichi AI Studio! Saya tertarik dengan asisten AI fisik Xichi.')}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Tanya Xichi di WhatsApp"
    >
      <span class="wa-float-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
      </span>
      <span>Tanya Xichi</span>
      <span class="wa-dot" aria-hidden="true"></span>
    </a>

    <PreorderModal />

    <script is:inline>
      (function () {
        var selector = [
          '.section-header',
          '.product-card',
          '.bento-item',
          '.culture-community-box',
          '.voice-item',
          '.tool-card',
          '.tools-header-action',
          '.tools-cta-row',
          '.comparison-table-wrapper',
          '.comparison-interactive-wrapper',
          '.phone-mockup',
          '.chronchi-card',
          '.feature-tile',
          '.about-founder-card',
          '.about-studio-card',
          '.procurement-banner',
          '.proc-card',
          '.faq-item',
          '.footer-desc',
          '.footer-social',
          '.footer-col',
          '.scroll-reveal'
        ].join(', ');

        function initScrollReveals() {
          var elements = document.querySelectorAll(selector);
          var vh = window.innerHeight || document.documentElement.clientHeight;

          // Reveal immediately if already in view (or above fold) on load
          elements.forEach(function (el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < vh - 20) {
              el.classList.add('in');
            }
          });

          if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('in');
                    observer.unobserve(entry.target);
                  }
                });
              },
              {
                threshold: 0.08,
                rootMargin: '0px 0px -40px 0px'
              }
            );

            elements.forEach(function (el) {
              if (!el.classList.contains('in')) {
                observer.observe(el);
              }
            });
          } else {
            elements.forEach(function (el) {
              el.classList.add('in');
            });
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollReveals);
        } else {
          initScrollReveals();
        }
      })();
    </script>
  </body>
</html>
