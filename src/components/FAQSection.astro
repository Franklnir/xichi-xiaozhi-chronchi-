---
// FAQSection.astro - Brutalist FAQ Accordion for SEO & Customer Confidence
import { faqItems } from '../data/faqs';
---
<section class="faq-section" id="faq">
  <header class="section-header">
    <p>09 / FAQ</p>
    <h2>
      <span class="word"><span>PERTANYAAN</span></span>{' '}
      <span class="word"><span>SERING</span></span>{' '}
      <span class="word"><span>DIAJUKAN.</span></span>
    </h2>
  </header>

  <div class="faq-container">
    {
      faqItems.map((faq, idx) => (
        <div class="faq-item" id={`faq-${idx}`}>
          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
            aria-controls={`faq-answer-${idx}`}
          >
            <span>{faq.question}</span>
            <span class="icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer" id={`faq-answer-${idx}`}>
            <p>{faq.answer}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // FAQ accordion toggling
  const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
  faqItems.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-question');
    btn?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach((i) => {
        i.classList.remove('active');
        i.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });
      if (!isActive) {
        item.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
  .faq-section {
    background: #ebebeb !important;
    padding: clamp(70px, 8vw, 110px) clamp(24px, 4vw, 48px) !important;
    position: relative;
  }

  .faq-section .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 52px;
  }

  .faq-section .section-header p {
    display: inline-block !important;
    background: #e4e61e !important;
    color: #0c0c0c !important;
    border: 1.5px solid #0c0c0c !important;
    box-shadow: 2px 2px 0 #0c0c0c !important;
    border-radius: 999px !important;
    padding: 5px 16px !important;
    font-weight: 800 !important;
    font-size: 12px !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    margin-bottom: 14px !important;
  }

  .faq-section .section-header h2,
  .faq-section .section-header h2 .word > span {
    color: #0c0c0c !important;
    font-family: 'Sora', system-ui, sans-serif !important;
    font-weight: 800 !important;
    font-size: clamp(2rem, 4.2vw, 3.2rem) !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    letter-spacing: -0.02em !important;
  }

  .faq-container {
    max-width: 860px !important;
    margin: 0 auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
  }

  .faq-item {
    background: #ffffff !important;
    border-radius: 24px !important;
    border: 2px solid #0c0c0c !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04) !important;
    overflow: hidden !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  }

  .faq-item:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08) !important;
  }

  .faq-question {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 16px !important;
    width: 100% !important;
    padding: 22px 26px !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    color: #0c0c0c !important;
    font-family: 'Sora', system-ui, sans-serif !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    text-align: left !important;
  }

  .faq-question .icon {
    display: grid !important;
    place-items: center !important;
    width: 32px !important;
    height: 32px !important;
    border-radius: 50% !important;
    background: #e4e61e !important;
    color: #0c0c0c !important;
    font-size: 18px !important;
    font-weight: 800 !important;
    flex-shrink: 0 !important;
    border: 1.5px solid #0c0c0c !important;
    transition: transform 0.2s ease, background 0.2s ease !important;
  }

  .faq-item.active .faq-question .icon {
    transform: rotate(45deg) !important;
    background: #0c0c0c !important;
    color: #ffffff !important;
  }

  .faq-answer {
    padding: 0 26px 24px !important;
    color: #4f4f4f !important;
    font-size: 14.5px !important;
    line-height: 1.65 !important;
    display: none;
  }

  .faq-item.active .faq-answer {
    display: block !important;
  }
</style>
