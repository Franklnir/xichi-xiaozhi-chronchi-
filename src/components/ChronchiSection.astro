---
// ChronchiSection.astro - 06 / Support Aplikasi Chronos (fbiego ecosystem)
import { chronchiConfig } from '../data/chronchi';

const { sectionBadge, sectionTitleWords, description, features, playStoreUrl, githubUrl } = chronchiConfig;
---

<section class="chronchi-section" id="chronchi">
  <header class="section-header">
    <p>{sectionBadge}</p>
    <h2>
      <span class="word"><span>CHRONOS</span></span>{' '}
      <span class="word"><span>—</span></span>{' '}
      <span class="word"><span>INTEGRASI</span></span>{' '}
      <span class="word"><span>HP</span></span>{' '}
      <span class="word"><span>VIA</span></span>{' '}
      <span class="word"><span>BLE.</span></span>
    </h2>
  </header>

  <div class="chronchi-grid">
    <!-- Real Chronos App Phone Mockup -->
    <div class="phone-mockup" aria-label="Tampilan antarmuka aplikasi Android Chronos by fbiego">
      <div class="phone-screen phone-screen-img">
        <img
          src="/assets/showcase/chronos-app.webp"
          alt="Antarmuka Aplikasi Android Chronos by fbiego"
          class="phone-app-real-img"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Chronos Copy & Feature List -->
    <div class="chronchi-content">
      <p class="chronchi-desc">
        {description}
      </p>

      <ul class="feature-list">
        {
          features.map((feat) => (
            <li>
              <div class="feature-num">{feat.num}</div>
              <div style="flex: 1;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">
                  <div class="feature-title">{feat.title}</div>
                  {feat.badge && <span class="feature-chip">{feat.badge}</span>}
                </div>
                <div class="feature-desc">{feat.desc}</div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="chronos-cta-group">
        <a
          href={playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brutal"
          style="flex: 1; justify-content: space-between;"
        >
          <span>📱 Google Play Store</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brutal outline"
          style="flex: 1; justify-content: space-between; background: transparent; color: var(--yellow); border-color: var(--yellow); box-shadow: 4px 4px 0 var(--yellow);"
        >
          <span>⭐ GitHub (fbiego)</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
