  }

  .verdict-icon.ok {
    color: #178a4c !important;
    font-weight: 900 !important;
    font-size: 15px !important;
    line-height: 1 !important;
  }

  .verdict-icon.bad {
    color: #e04874 !important;
    font-weight: 900 !important;
    font-size: 14px !important;
    line-height: 1 !important;
  }

  .cell-title {
    font-size: 13.5px !important;
    font-weight: 700 !important;
    color: #0c0c0c !important;
    font-family: 'Sora', sans-serif !important;
  }

  .spec-chip {
    display: inline-block !important;
    padding: 2px 8px !important;
    border-radius: 999px !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
  }

  .spec-chip.xichi-tag {
    background: #faf4b7 !important;
    color: #0c0c0c !important;
    border: 1px solid #e4e61e !important;
  }

  .spec-chip.conv-tag {
    background: #eeeeea !important;
    color: #666666 !important;
    border: 1px solid rgba(12, 12, 12, 0.09) !important;
  }

  .cell-desc {
    font-size: 12.5px !important;
    color: #4f4f4f !important;
    line-height: 1.45 !important;
    margin: 0 !important;
  }

  /* ------------------------------------------------------------
     2. BELAJAR AI INTERACTIVE CARD VIEW (.compare-box)
     ------------------------------------------------------------ */
  .comparison-interactive-wrapper {
    background: #ffffff !important;
    border-radius: 28px !important;
    border: 1.5px solid rgba(12, 12, 12, 0.12) !important;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.04) !important;
    padding: 24px 28px !important;
  }

  /* Horizontal Pill Selector */
  .comp-tabs-bar {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
    justify-content: center !important;
    padding-bottom: 20px !important;
    border-bottom: 1.5px solid rgba(12, 12, 12, 0.08) !important;
    margin-bottom: 20px !important;
  }

  .comp-tab-pill {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    padding: 7px 16px !important;
    border-radius: 999px !important;
    background: #fafaf5 !important;
    color: #0c0c0c !important;
    border: 1.5px solid rgba(12, 12, 12, 0.12) !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: all 0.15s ease !important;
  }

  .comp-tab-pill:hover {
    background: #ebebeb !important;
    transform: translateY(-2px) !important;
  }

  .comp-tab-pill.active {
    background: #0c0c0c !important;
    color: #ffffff !important;
    border-color: #0c0c0c !important;
  }

  .comp-tab-pill .tab-index {
    font-family: 'Sora', monospace !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    opacity: 0.75 !important;
  }

  .comp-panel-top {
    text-align: center !important;
    margin-bottom: 18px !important;
  }

  .panel-badge {
    display: inline-block !important;
    font-size: 10.5px !important;
    font-weight: 800 !important;
    color: #777777 !important;
    letter-spacing: 0.06em !important;
    margin-bottom: 4px !important;
  }

  .panel-category-name {
    font-family: 'Sora', sans-serif !important;
    font-size: clamp(16px, 2vw, 20px) !important;
    font-weight: 800 !important;
    color: #0c0c0c !important;
    margin: 0 !important;
  }

  /* Compare Grid: 2 Side-by-Side Cards (Belajar AI Style) */
  .compare-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 16px !important;
    margin-bottom: 20px !important;
  }

  .compare-card {
    border-radius: 20px !important;
    padding: 22px 24px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    border: 1.5px solid rgba(12, 12, 12, 0.1) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease !important;
  }

  .compare-card:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06) !important;
  }

  .compare-card.is-conv {
    background: #fafaf6 !important;
  }

  .compare-card.is-xichi {
    background: #faf4b7 !important;
    border-color: #e4e61e !important;
    box-shadow: 0 6px 20px rgba(228, 230, 30, 0.15) !important;
  }

  .card-side-head {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    margin-bottom: 10px !important;
  }

  .badge-tag {
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: 0.04em !important;
    padding: 3px 10px !important;
    border-radius: 999px !important;
  }

  .badge-tag.conv {
    background: #eeeeea !important;
    color: #666666 !important;
    border: 1px solid rgba(12, 12, 12, 0.1) !important;
  }

  .badge-tag.xichi {
    background: #e4e61e !important;
    color: #0c0c0c !important;
    border: 1px solid #0c0c0c !important;
  }

  .mini-chip {
    font-size: 10px !important;
    font-weight: 800 !important;
    padding: 2px 8px !important;
    border-radius: 999px !important;
    background: #ffffff !important;
    color: #4f4f4f !important;
    border: 1px solid rgba(12, 12, 12, 0.1) !important;
  }

  .mini-chip.xichi {
    background: #0c0c0c !important;
    color: #ffffff !important;
    border-color: #0c0c0c !important;
  }

  .card-verdict-title {
    font-family: 'Sora', sans-serif !important;
    font-size: 16px !important;
    font-weight: 800 !important;
    color: #0c0c0c !important;
    margin: 0 0 8px !important;
    line-height: 1.3 !important;
  }

  .card-verdict-desc {
    font-size: 13.5px !important;
    color: #3f3f3f !important;
    line-height: 1.55 !important;
    margin: 0 !important;
  }

  /* Compact Bottom Navigation */
  .comp-panel-nav {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding-top: 14px !important;
    border-top: 1.5px solid rgba(12, 12, 12, 0.08) !important;
  }

  .btn-nav-step {
    border-radius: 999px !important;
    padding: 8px 20px !important;
    background: #0c0c0c !important;
    color: #ffffff !important;
    border: none !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: background 0.15s ease, opacity 0.15s ease !important;
  }

  .btn-nav-step:hover:not(:disabled) {
    background: #2b2b2b !important;
  }

  .btn-nav-step:disabled {
    opacity: 0.35 !important;
    cursor: not-allowed !important;
    background: #888888 !important;
  }

  .nav-count-indicator {
    font-size: 12px !important;
    font-weight: 800 !important;
    color: #777777 !important;
    font-family: 'Sora', monospace !important;
  }

  /* Responsive Rules */
  @media (max-width: 860px) {
    .comparison-table-wrapper {
      display: none !important;
    }
    .comparison-interactive-wrapper {
      display: block !important;
      padding: 18px 16px !important;
    }
    .comp-view-toggle-bar {
      display: none !important;
    }
    .compare-grid {
      grid-template-columns: 1fr !important;
      gap: 12px !important;
    }
    .comp-tabs-bar {
      overflow-x: auto !important;
