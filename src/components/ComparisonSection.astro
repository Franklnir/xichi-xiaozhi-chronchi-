---
// ComparisonSection.astro - 05 / Komparasi 'Xichi vs Smart Speaker Konvensional' (Compact Belajar AI Design)
import { comparisonData } from '../data/comparisons';
---

<section class="comparison-section" id="comparison">
  <header class="section-header">
    <p>05 / Komparasi</p>
    <h2>
      <span class="word"><span>XICHI</span></span>{' '}
      <span class="word"><span>VS</span></span>{' '}
      <span class="word"><span>SPEAKER</span></span>{' '}
      <span class="word"><span>KONVENSIONAL.</span></span>
    </h2>
    <div class="comp-view-toggle-bar">
      <div class="comp-view-toggle" role="tablist" aria-label="Pilih format tampilan">
        <button type="button" class="comp-toggle-btn active" id="btnToggleTable" aria-selected="true" aria-controls="compTableView">
          <span>▦ Tabel Ringkas</span>
        </button>
        <button type="button" class="comp-toggle-btn" id="btnToggleCards" aria-selected="false" aria-controls="compCardsView">
          <span>📑 Kartu Perbandingan</span>
        </button>
      </div>
    </div>
  </header>

  <div class="comparison-container">
    <!-- VIEW 1: Ultra-Compact Slim Table (Desktop & Tablets) -->
    <div class="comparison-table-wrapper" id="compTableView">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="th-criteria">KRITERIA</th>
            <th class="th-xichi">
              <div class="brand-pill xichi-brand-pill">
                <span class="pill-badge">★ REKOMENDASI TERBAIK</span>
                <span class="pill-name">XICHI PHYSICAL AI</span>
              </div>
            </th>
            <th class="th-conventional">
              <div class="brand-pill conv-brand-pill">
                <span class="pill-badge muted">SPEAKER BIASA</span>
                <span class="pill-name">GOOGLE NEST / ALEXA</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            comparisonData.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'even-row' : 'odd-row'}>
                <td class="td-category">
                  <div class="cat-lockup">
                    <span class="cat-idx">0{idx + 1}</span>
                    <strong class="cat-label">{row.category}</strong>
                  </div>
                </td>
                <td class="td-xichi">
                  <div class="cell-box">
                    <div class="cell-head">
                      <span class="verdict-icon ok" aria-hidden="true">✓</span>
                      <strong class="cell-title">{row.xichi.title}</strong>
                      {row.xichi.tag && <span class="spec-chip xichi-tag">{row.xichi.tag}</span>}
                    </div>
                    <p class="cell-desc">{row.xichi.description}</p>
                  </div>
                </td>
                <td class="td-conventional">
                  <div class="cell-box">
                    <div class="cell-head">
                      <span class="verdict-icon bad" aria-hidden="true">✕</span>
                      <strong class="cell-title">{row.conventional.title}</strong>
                      {row.conventional.tag && <span class="spec-chip conv-tag">{row.conventional.tag}</span>}
                    </div>
                    <p class="cell-desc">{row.conventional.description}</p>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- VIEW 2: Belajar AI Interactive Compare Card (.compare-box) -->
    <div class="comparison-interactive-wrapper" id="compCardsView" style="display: none;">
      <!-- Category Tabs (Horizontal Pill Selector) -->
      <div class="comp-tabs-bar" role="tablist" aria-label="Pilih kriteria untuk dibandingkan">
        {
          comparisonData.map((row, idx) => (
            <button
              type="button"
              class={`comp-tab-pill ${idx === 0 ? 'active' : ''}`}
              data-index={idx}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="tab-index">0{idx + 1}</span>
              <span class="tab-text">{row.category.split(' ')[0]}</span>
            </button>
          ))
        }
      </div>

      <!-- Compare Panels -->
      <div class="comp-cards-deck">
        {
          comparisonData.map((row, idx) => (
            <div
              class={`comp-panel ${idx === 0 ? 'active' : ''}`}
              data-panel={idx}
              role="tabpanel"
              style={idx === 0 ? 'display: block;' : 'display: none;'}
            >
              <div class="comp-panel-top">
                <span class="panel-badge">KRITERIA 0{idx + 1}</span>
                <h3 class="panel-category-name">{row.category}</h3>
              </div>

              <div class="compare-grid">
                <!-- Conventional Side -->
                <div class="compare-card is-conv">
                  <div class="card-side-head">
                    <span class="badge-tag conv">✕ GOOGLE NEST / ALEXA</span>
                    {row.conventional.tag && <span class="mini-chip">{row.conventional.tag}</span>}
                  </div>
                  <h4 class="card-verdict-title">{row.conventional.title}</h4>
                  <p class="card-verdict-desc">{row.conventional.description}</p>
                </div>

                <!-- Xichi Side (Belajar AI Highlight) -->
                <div class="compare-card is-xichi">
                  <div class="card-side-head">
                    <span class="badge-tag xichi">★ XICHI PHYSICAL AI</span>
                    {row.xichi.tag && <span class="mini-chip xichi">{row.xichi.tag}</span>}
                  </div>
                  <h4 class="card-verdict-title">{row.xichi.title}</h4>
                  <p class="card-verdict-desc">{row.xichi.description}</p>
                </div>
              </div>

              <!-- Compact Navigation -->
              <div class="comp-panel-nav">
                <button
                  type="button"
                  class="btn-nav-step prev-step"
                  data-target={idx - 1}
                  disabled={idx === 0}
                  aria-label="Kriteria sebelumnya"
                >
                  ← Sebelumnya
                </button>
                <span class="nav-count-indicator">
                  {idx + 1} / {comparisonData.length}
                </span>
                <button
                  type="button"
                  class="btn-nav-step next-step"
                  data-target={idx + 1}
                  disabled={idx === comparisonData.length - 1}
                  aria-label="Kriteria selanjutnya"
                >
                  Selanjutnya →
                </button>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Toggle between Table and Interactive Cards
  const btnTable = document.getElementById('btnToggleTable');
  const btnCards = document.getElementById('btnToggleCards');
  const viewTable = document.getElementById('compTableView');
  const viewCards = document.getElementById('compCardsView');

  function showTable() {
    if (!viewTable || !viewCards) return;
    viewTable.style.display = 'block';
    viewCards.style.display = 'none';
    btnTable?.classList.add('active');
    btnTable?.setAttribute('aria-selected', 'true');
    btnCards?.classList.remove('active');
    btnCards?.setAttribute('aria-selected', 'false');
  }

  function showCards() {
    if (!viewTable || !viewCards) return;
    viewTable.style.display = 'none';
    viewCards.style.display = 'block';
    btnCards?.classList.add('active');
    btnCards?.setAttribute('aria-selected', 'true');
    btnTable?.classList.remove('active');
    btnTable?.setAttribute('aria-selected', 'false');
  }

  btnTable?.addEventListener('click', showTable);
  btnCards?.addEventListener('click', showCards);

  // Auto-switch to cards on mobile screen resize
  function handleScreenResize() {
    if (window.innerWidth <= 860) {
      showCards();
    }
  }
  window.addEventListener('resize', handleScreenResize);
  if (window.innerWidth <= 860) {
    showCards();
  }

  // Interactive Tabbed Card Navigation
  const tabPills = document.querySelectorAll<HTMLButtonElement>('.comp-tab-pill');
  const panels = document.querySelectorAll<HTMLElement>('.comp-panel');
  const navSteps = document.querySelectorAll<HTMLButtonElement>('.btn-nav-step');

  function setActiveCriteria(targetIdx: number) {
    if (targetIdx < 0 || targetIdx >= tabPills.length) return;

    tabPills.forEach((pill, i) => {
      const isMatch = i === targetIdx;
      pill.classList.toggle('active', isMatch);
      pill.setAttribute('aria-selected', isMatch ? 'true' : 'false');
    });

    panels.forEach((p, i) => {
      const isMatch = i === targetIdx;
      p.style.display = isMatch ? 'block' : 'none';
      p.classList.toggle('active', isMatch);
    });
  }

  tabPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const idx = Number(pill.getAttribute('data-index') || '0');
      setActiveCriteria(idx);
    });
  });

  navSteps.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = Number(btn.getAttribute('data-target'));
      if (!isNaN(target)) {
        setActiveCriteria(target);
      }
    });
  });
</script>

<style>
  /* ============================================================
     COMPACT BELAJAR AI COMPARISON SECTION (LOW PROFILE & TIGHT)
     ============================================================ */

  .comparison-section {
    background: #ebebeb !important;
    padding: clamp(38px, 4vw, 56px) clamp(20px, 4vw, 40px) !important;
    position: relative !important;
  }

  .comparison-section .section-header {
    text-align: center !important;
    max-width: 800px !important;
    margin: 0 auto 24px !important;
  }

  .comparison-section .section-header p {
    display: inline-block !important;
    background: #e4e61e !important;
    color: #0c0c0c !important;
    border: 1.5px solid #0c0c0c !important;
    border-radius: 999px !important;
    padding: 4px 14px !important;
    font-weight: 800 !important;
    font-size: 11px !important;
