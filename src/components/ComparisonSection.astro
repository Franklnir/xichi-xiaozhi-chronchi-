  }

  .brand-pill.conv-brand-pill {
    background: #f0f0ea !important;
    color: #4f4f4f !important;
    border: 1px solid rgba(12, 12, 12, 0.1) !important;
  }

  /* Table Body */
  .comparison-table tbody tr {
    border-bottom: 1px solid rgba(12, 12, 12, 0.07) !important;
