---
// ToolsSection.astro - 03 / Superpowers (36 MCP Tools, 8 Pilar)
import { mcpToolPillars } from '../data/tools';
import { mcpCatalogue } from '../data/mcpCatalogue';
---

<section class="tools-section" id="tools">
  <header class="section-header dark">
    <p>04 / Superpowers</p>
    <h2>
      <span class="word"><span>47</span></span>{' '}
      <span class="word"><span>MCP</span></span>{' '}
      <span class="word"><span>TOOLS.</span></span>{' '}
      <span class="word"><span>DELAPAN</span></span>{' '}
      <span class="word"><span>PILAR.</span></span>
    </h2>
    <div class="tools-header-action">
      <button
        type="button"
        class="btn-tools-header open-mcp-modal"
        id="btnOpenMcpHeader"
        data-open-modal="mcpModal"
        onclick="if(window.openMcpModal){window.openMcpModal();}else{var m=document.getElementById('mcpModal');if(m){m.classList.add('active');m.style.setProperty('display','flex','important');m.style.setProperty('opacity','1','important');m.style.setProperty('visibility','visible','important');m.style.setProperty('pointer-events','auto','important');m.style.setProperty('z-index','999999','important');document.body.style.overflow='hidden';}}"
        aria-haspopup="dialog"
        aria-controls="mcpModal"
      >
        <span>⚡ Klik Di Sini Untuk Melihat Seluruh Daftar Tools & Contoh Perintah Suara</span>
        <span class="arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </header>

  <div class="tools-grid">
    {
      mcpToolPillars.map((tool) => (
        <div class="tool-card" data-tool-id={tool.id}>
          <div class="tool-icon" aria-hidden="true">
            {tool.iconType === 'music' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13" />
                <circle cx="6" cy="18" r="3" />
                <circle cx="18" cy="16" r="3" />
              </svg>
            )}

            {tool.iconType === 'memory' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 1 0 10 10H12V2z" />
              </svg>
            )}

            {tool.iconType === 'education' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                <path d="M6 12v5c3 3 9 3 12 0v-5" />
              </svg>
            )}

            {tool.iconType === 'code' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6" />
                <polyline points="8 6 2 12 8 18" />
              </svg>
            )}

            {tool.iconType === 'heart' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
            )}

            {tool.iconType === 'worship' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M2 12h20" />
              </svg>
            )}

            {tool.iconType === 'cloud' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
              </svg>
            )}

            {tool.iconType === 'home' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
            )}
          </div>

          <h3 class="tool-title">{tool.title}</h3>
          <p class="tool-desc">{tool.description}</p>
          <div class="tool-count">
            <span>TOOLS</span>
            <span class="num">{tool.count}</span>
          </div>
        </div>
      ))
    }
  </div>

  <div class="tools-cta-row">
    <button
      type="button"
      class="btn btn-dark open-mcp-modal"
      data-open-modal="mcpModal"
      onclick="if(window.openMcpModal){window.openMcpModal();}else{var m=document.getElementById('mcpModal');if(m){m.classList.add('active');m.style.setProperty('display','flex','important');m.style.setProperty('opacity','1','important');m.style.setProperty('visibility','visible','important');m.style.setProperty('pointer-events','auto','important');m.style.setProperty('z-index','999999','important');document.body.style.overflow='hidden';}}"
      style="padding: 16px 32px; font-size: 14px;"
    >
      <span>📖 Buka Katalog Lengkap 47+ MCP Tools</span>
      <span class="arrow" aria-hidden="true">→</span>
    </button>
  </div>

  <!-- MCP Superpowers Catalogue Modal Overlay -->
  <div class="mcp-modal-overlay" id="mcpModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="mcp-modal-card">
      <button
        type="button"
        class="mcp-modal-close"
        id="closeMcpModal"
        onclick="window.closeMcpModal && window.closeMcpModal()"
        aria-label="Tutup katalog MCP"
      >×</button>

      <div class="mcp-modal-head">
        <div class="mcp-badge-top">
          <span class="mcp-badge-proto">MODEL CONTEXT PROTOCOL (MCP)</span>
          <span class="mcp-badge-count">10 KATEGORI · 47+ TOOLS</span>
        </div>
        <h3 class="mcp-modal-title">KATALOG LENGKAP MCP SUPERPOWERS</h3>
        <p class="mcp-modal-sub">
          Daftar lengkap kemampuan teknis, pilar spesialis, dan contoh perintah suara instan (voice prompt) untuk asisten AI fisik Xichi.
        </p>

        <!-- Filter Category Pills -->
        <div class="mcp-pills-row" id="mcpCategoryPills">
          <button type="button" class="mcp-cat-pill active" data-cat="all">Semua ({mcpCatalogue.reduce((acc, c) => acc + c.tools.length, 0)})</button>
          {
            mcpCatalogue.map((cat) => (
              <button type="button" class="mcp-cat-pill" data-cat={cat.id}>
                <span>{cat.icon}</span> <span>{cat.title}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Scrollable Catalogue Body -->
      <div class="mcp-modal-body" id="mcpModalBody">
        {
          mcpCatalogue.map((cat) => (
            <section class="mcp-cat-section" data-cat-id={cat.id}>
              <div class="mcp-cat-header">
                <div class="mcp-cat-num">{cat.number}</div>
                <div>
                  <h4 class="mcp-cat-title">
                    <span class="cat-icon">{cat.icon}</span> {cat.title}
                  </h4>
                  <p class="mcp-cat-tagline">{cat.tagline}</p>
                </div>
              </div>

              <div class="mcp-tools-list">
                {
                  cat.tools.map((tool) => (
                    <article class="mcp-tool-card" data-tool-name={tool.name} data-tool-desc={tool.description} data-tool-prompt={tool.promptExample || ''}>
                      <div class="mcp-tool-top">
                        <code class="mcp-tool-id">{tool.name}</code>
                        {tool.badge && <span class="mcp-tool-badge">{tool.badge}</span>}
                      </div>
                      <p class="mcp-tool-desc">{tool.description}</p>
                      {tool.parameters && (
                        <div class="mcp-tool-params">
                          <span class="param-label">Parameter:</span> <code>{tool.parameters}</code>
                        </div>
                      )}
                      {tool.promptExample && (
                        <div class="mcp-tool-prompt">
                          <span class="prompt-icon" aria-hidden="true">🗣️</span>
                          <span class="prompt-text">"{tool.promptExample}"</span>
                        </div>
                      )}
                    </article>
                  ))
                }
              </div>
            </section>
          ))
        }
      </div>

      <div class="mcp-modal-footer">
        <div class="footer-info">
          💡 <strong>Tips Suara:</strong> Cukup ucapkan salah satu contoh perintah suara di atas saat berdialog dengan Xichi.
        </div>
        <button
          type="button"
          class="btn btn-dark"
          id="btnCloseMcpFooter"
          onclick="window.closeMcpModal && window.closeMcpModal()"
        >
          <span>Tutup Katalog</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Hoist modal overlay directly to document.body so it is never trapped by any section stacking context
    function ensureModalInBody() {
      var modal = document.getElementById('mcpModal');
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensureModalInBody);
    } else {
      ensureModalInBody();
    }

    window.openMcpModal = function () {
      ensureModalInBody();
      var modal = document.getElementById('mcpModal');
      if (!modal) return;
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      modal.style.setProperty('display', 'flex', 'important');
      modal.style.setProperty('opacity', '1', 'important');
      modal.style.setProperty('visibility', 'visible', 'important');
      modal.style.setProperty('pointer-events', 'auto', 'important');
      modal.style.setProperty('z-index', '999999', 'important');
      document.body.style.overflow = 'hidden';
    };

    window.closeMcpModal = function () {
      var modal = document.getElementById('mcpModal');
      if (!modal) return;
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      modal.style.setProperty('display', 'none', 'important');
      modal.style.setProperty('opacity', '0', 'important');
      modal.style.setProperty('visibility', 'hidden', 'important');
      modal.style.setProperty('pointer-events', 'none', 'important');
      document.body.style.overflow = '';
      if (window.location.hash === '#mcp' || window.location.hash === '#katalog-mcp') {
        history.replaceState(null, '', '#tools');
      }
    };

    function checkHash() {
      if (window.location.hash === '#mcp' || window.location.hash === '#katalog-mcp') {
        window.openMcpModal();
      }
    }

    function bindEvents() {
      // 1. Direct triggers
      var openButtons = document.querySelectorAll('#btnOpenMcpHeader, .open-mcp-modal, [data-open-modal="mcpModal"]');
      openButtons.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          window.openMcpModal();
        });
      });

      // 2. Direct close triggers
      var closeButtons = document.querySelectorAll('#closeMcpModal, #btnCloseMcpFooter, .mcp-modal-close');
      closeButtons.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          window.closeMcpModal();
        });
      });

      // 3. Modal backdrop click
      var modal = document.getElementById('mcpModal');
      if (modal) {
        modal.addEventListener('click', function (e) {
          if (e.target === modal) {
            window.closeMcpModal();
          }
        });
      }

      // 4. Category filter pills
      var currentCategory = 'all';
      var catPills = document.querySelectorAll('.mcp-cat-pill');
      var catSections = document.querySelectorAll('.mcp-cat-section');

      function filterTools() {
        catSections.forEach(function (section) {
          var catId = section.getAttribute('data-cat-id');
          var matchesCat = currentCategory === 'all' || catId === currentCategory;
          var cards = section.querySelectorAll('.mcp-tool-card');
          var sectionHasVisibleTool = false;

          cards.forEach(function (card) {
            if (matchesCat) {
              card.style.display = 'flex';
              sectionHasVisibleTool = true;
            } else {
              card.style.display = 'none';
            }
          });

          section.style.display = sectionHasVisibleTool ? 'flex' : 'none';
        });
      }

      catPills.forEach(function (pill) {
        pill.addEventListener('click', function (e) {
          e.preventDefault();
          catPills.forEach(function (p) {
            p.classList.remove('active');
          });
          pill.classList.add('active');
          currentCategory = pill.getAttribute('data-cat') || 'all';
          filterTools();
        });
      });
    }

    // Capture-phase document click delegation: catches all clicks on button or inner elements
    document.addEventListener(
      'click',
      function (e) {
        var target = e.target;
        if (!target) return;

        var openBtn = target.closest && target.closest('#btnOpenMcpHeader, .open-mcp-modal, [data-open-modal="mcpModal"]');
        if (openBtn) {
          e.preventDefault();
          e.stopPropagation();
          window.openMcpModal();
          return;
        }

        var closeBtn = target.closest && target.closest('#closeMcpModal, #btnCloseMcpFooter, .mcp-modal-close');
        if (closeBtn) {
          e.preventDefault();
          e.stopPropagation();
          window.closeMcpModal();
          return;
        }
      },
      true
    );

    // Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var modal = document.getElementById('mcpModal');
        if (modal && modal.classList.contains('active')) {
          window.closeMcpModal();
        }
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        bindEvents();
        checkHash();
      });
    } else {
      bindEvents();
      checkHash();
    }

    window.addEventListener('hashchange', checkHash);
  })();
</script>

<style>
  .tools-section {
    background: #ebebeb !important;
    padding: clamp(70px, 8vw, 110px) clamp(24px, 4vw, 48px) !important;
    position: relative;
  }

  .tools-section .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 48px;
  }

  .tools-section .section-header p {
    display: inline-block !important;
    background: #e4e61e !important;
    color: #0c0c0c !important;
    border: 1.5px solid rgba(12, 12, 12, 0.14) !important;
    box-shadow: 2px 2px 0 #0c0c0c !important;
    border-radius: 999px !important;
    padding: 5px 16px !important;
    font-weight: 800 !important;
    font-size: 12px !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    margin-bottom: 14px !important;
  }

  .tools-section .section-header h2,
  .tools-section .section-header h2 .word > span {
    color: #0c0c0c !important;
    font-family: 'Sora', system-ui, sans-serif !important;
    font-weight: 800 !important;
    font-size: clamp(2rem, 4.2vw, 3.2rem) !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    letter-spacing: -0.02em !important;
  }

  .tools-header-action {
    margin-top: 18px;
    position: relative !important;
    z-index: 10 !important;
  }

  .btn-tools-header {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 12px 26px !important;
    background: #ffffff !important;
    color: #0c0c0c !important;
    border: 1.5px solid #0c0c0c !important;
    border-radius: 999px !important;
    font-size: 13.5px !important;
    font-weight: 700 !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06) !important;
    cursor: pointer !important;
    position: relative !important;
    z-index: 10 !important;
    pointer-events: auto !important;
    user-select: none !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease !important;
  }

  .btn-tools-header * {
    pointer-events: none !important;
  }

  .btn-tools-header:hover {
    transform: translateY(-2px) !important;
    background: #e4e61e !important;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12) !important;
  }

  .tools-grid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 20px !important;
    max-width: 1140px !important;
    margin: 0 auto !important;
  }

  .tool-card {
    background: #ffffff !important;
    border-radius: 26px !important;
    padding: 28px 22px !important;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.05) !important;
    border: 1.5px solid rgba(12, 12, 12, 0.08) !important;
    display: flex !important;
    flex-direction: column !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
    position: relative !important;
  }

  .tool-card:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.09) !important;
    border-color: #0c0c0c !important;
  }

  .tool-icon {
    width: 52px !important;
    height: 52px !important;
    border-radius: 16px !important;
    background: #e4e61e !important;
    color: #0c0c0c !important;
    display: grid !important;
    place-items: center !important;
    margin-bottom: 18px !important;
    border: 1.5px solid #0c0c0c !important;
  }

  .tool-icon svg {
    width: 24px !important;
    height: 24px !important;
  }

  .tool-title {
    font-size: 17px !important;
    font-weight: 800 !important;
    color: #0c0c0c !important;
    font-family: 'Sora', sans-serif !important;
    margin-bottom: 8px !important;
    line-height: 1.25 !important;
  }

  .tool-desc {
    font-size: 13.5px !important;
    color: #4f4f4f !important;
    line-height: 1.6 !important;
    margin-bottom: 18px !important;
    flex-grow: 1 !important;
  }

  .tool-count {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 6px 14px !important;
    border-radius: 999px !important;
    background: #fafaf5 !important;
    border: 1px solid rgba(12, 12, 12, 0.09) !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    color: #0c0c0c !important;
  }

  .tool-count .num {
    background: #0c0c0c !important;
    color: #ffffff !important;
    padding: 2px 8px !important;
    border-radius: 999px !important;
    font-size: 10px !important;
  }

  .tools-cta-row {
    text-align: center !important;
    margin-top: 48px !important;
  }

  .tools-cta-row .btn-brutal {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 16px 36px !important;
    background: #0c0c0c !important;
    color: #ffffff !important;
    border-radius: 999px !important;
    font-size: 14.5px !important;
    font-weight: 700 !important;
    border: none !important;
    cursor: pointer !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14) !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  }

  .tools-cta-row .btn-brutal:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22) !important;
    background: #1f1f1f !important;
  }

  @media (max-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 640px) {
    .btn-tools-header {
      width: calc(100% - 24px) !important;
      max-width: 360px !important;
      padding: 11px 16px !important;
      font-size: 12px !important;
      line-height: 1.4 !important;
      justify-content: center !important;
      text-align: center !important;
      white-space: normal !important;
    }

    .tools-grid {
      grid-template-columns: 1fr !important;
    }

    .tools-cta-row .btn-brutal,
    .tools-cta-row .btn {
      width: 100% !important;
      max-width: 330px !important;
      padding: 14px 20px !important;
      font-size: 13.5px !important;
      justify-content: center !important;
      white-space: normal !important;
      text-align: center !important;
    }
  }
</style>
