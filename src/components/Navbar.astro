---
// Navbar.astro - Belajar AI Style Clean Floating Island Navigation
import { siteConfig } from '../data/siteConfig';

const navItems = siteConfig.navItems;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';

// Format href so subpages can jump to home anchors seamlessly
const resolveHref = (href: string) => {
  if (href.startsWith('#')) {
    return isHome ? href : `/${href}`;
  }
  return href;
};
---

<header class="site-header">
  <nav class="nav" id="navbar" aria-label="Navigasi utama">
    <a href={isHome ? '#home' : '/'} class="logo" aria-label="Xichi AI — Beranda">
      <img src="/assets/logoxichi.jpg" alt="Logo Xichi AI" width="40" height="40" />
      <span class="logo-text">
        <b>Xichi AI</b>
        <small>Asisten Fisik Meja Kerja</small>
      </span>
    </a>

    <ul class="nav-links">
      {
        navItems.map((item, idx) => {
          const href = resolveHref(item.href);
          const isActive = isHome ? idx === 0 : currentPath === item.href;
          return (
            <li>
              <a href={href} class={isActive ? 'active' : ''} data-section={item.sectionId}>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="nav-right">
      <button type="button" class="btn btn-sm btn-dark open-preorder-modal" aria-label="Buka form pre-order">
        Pre-Order <span aria-hidden="true">→</span>
      </button>

      <button
        class="hamburger"
        id="hamburger"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <div class="mobile-links">
        {
          navItems.map((item) => (
            <a href={resolveHref(item.href)} class="mobile-link">
              {item.label}
            </a>
          ))
        }
        <button
          type="button"
          class="btn btn-dark open-preorder-modal"
          style="margin-top: 18px; width: 100%; background: #0c0c0c !important; background-color: #0c0c0c !important; color: #ffffff !important;"
        >
          Pre-Order Sekarang →
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .btn-dark {
    background: #0c0c0c !important;
    color: #ffffff !important;
    border-radius: 999px !important;
    font-family: 'Sora', system-ui, sans-serif !important;
    font-weight: 700 !important;
    border: none !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease !important;
  }
  .btn-sm {
    padding: 9px 20px !important;
    font-size: 13.5px !important;
  }
  .btn-dark:hover {
    background: #1f1f1f !important;
    color: #ffffff !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.16) !important;
  }
  .mobile-links .btn-dark {
    padding: 14px 24px !important;
    font-size: 15px !important;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12) !important;
  }
</style>

<script is:inline>
  (function () {
    var header = document.querySelector('header.site-header');
    var navbar = document.getElementById('navbar');
    var hamburger = document.getElementById('hamburger');
    var mobileMenu = document.getElementById('mobileMenu');
    var navLinks = document.querySelectorAll('.nav-links a');
    var mobileLinks = document.querySelectorAll('.mobile-link');

    var lastScrollY = window.scrollY;
    var isTicking = false;

    function handleScroll() {
      var currentScrollY = window.scrollY;
      var isMobileOpen = mobileMenu && mobileMenu.classList.contains('active');

      // Do not hide navbar if mobile menu is open
      if (isMobileOpen) {
        if (header) header.classList.remove('nav-hidden');
        isTicking = false;
        return;
      }

      // At the very top (normal resting state, not floating)
      if (currentScrollY <= 25) {
        if (header) {
          header.classList.remove('nav-hidden');
          header.classList.remove('is-floating');
        }
        if (navbar) navbar.classList.remove('scrolled');
        lastScrollY = currentScrollY;
        isTicking = false;
        return;
      }

      var delta = currentScrollY - lastScrollY;

      // Sensitivity threshold (6px) to avoid twitching
      if (Math.abs(delta) > 6) {
        if (delta > 0 && currentScrollY > 90) {
          // Scrolling DOWN -> Sembunyikan navbar ke atas
          if (header) {
            header.classList.add('nav-hidden');
          }
        } else if (delta < 0) {
          // Scrolling UP -> Munculkan navbar tampil seperti ngambang (floating island)
          if (header) {
            header.classList.remove('nav-hidden');
            header.classList.add('is-floating');
          }
          if (navbar) navbar.classList.add('scrolled');
        }
        lastScrollY = currentScrollY;
      }

      isTicking = false;
    }

    window.addEventListener(
      'scroll',
      function () {
        if (!isTicking) {
          window.requestAnimationFrame(handleScroll);
          isTicking = true;
        }
      },
      { passive: true }
    );

    // Initial check
    handleScroll();

    // Toggle mobile menu
    if (hamburger && mobileMenu) {
      hamburger.addEventListener('click', function () {
        var open = mobileMenu.classList.toggle('active');
        hamburger.classList.toggle('active', open);
        hamburger.setAttribute('aria-expanded', String(open));
        if (header) header.classList.remove('nav-hidden');
        document.body.style.overflow = open ? 'hidden' : '';
      });

      mobileLinks.forEach(function (l) {
        l.addEventListener('click', function () {
          hamburger.classList.remove('active');
          mobileMenu.classList.remove('active');
          hamburger.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });
    }

    // Active link on scroll
    var sectionIds = ['home', 'products', 'culture', 'voice', 'tools', 'comparison', 'chronchi', 'about', 'pengadaan', 'faq'];
    window.addEventListener(
      'scroll',
      function () {
        var currentSection = 'home';
        var scrollPos = window.scrollY;
        for (var i = 0; i < sectionIds.length; i++) {
          var el = document.getElementById(sectionIds[i]);
          if (el && scrollPos >= el.offsetTop - 220) {
            currentSection = sectionIds[i];
          }
        }
        navLinks.forEach(function (link) {
          var target = (link.getAttribute('href') || '').replace('#', '').replace('/', '');
          if (target === currentSection) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      },
      { passive: true }
    );
  })();
</script>
