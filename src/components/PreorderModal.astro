---
// PreorderModal.astro - Brutalist interactive checkout modal ready for WhatsApp & Backend API
import { siteConfig } from '../data/siteConfig';

const { whatsappNumber } = siteConfig;
---
<div class="modal-overlay" id="preorderModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-card">
    <button type="button" class="modal-close" id="closePreorderModal" aria-label="Tutup form pre-order">×</button>

    <h3 class="modal-title" id="modalTitle">PRE-ORDER XICHI AI</h3>
    <p class="modal-sub">Pilih varian favoritmu. Tim kami akan segera mengonfirmasi ketersediaan unit dan pengiriman.</p>

    <form class="modal-form" id="preorderForm">
      <div class="form-group">
        <label for="variantSelect">Varian Produk</label>
        <select class="form-select" id="variantSelect" name="variant" required>
          <option value="Xichi Pocket (C3 Mini - Rp 300.000)">Xichi Pocket (C3 Mini - Rp 300.000)</option>
          <option value="Xichi Core (Unit Jadi - Rp 560.000)">Xichi Core (Unit Jadi - Rp 560.000)</option>
          <option value="Xichi Vision Pro (S3 CAM - Rp 630.000)">Xichi Vision Pro (S3 CAM - Rp 630.000)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="customerName">Nama Lengkap</label>
        <input type="text" class="form-input" id="customerName" name="name" placeholder="Misal: Irsyad" required />
      </div>

      <div class="form-group">
        <label for="customerPhone">Nomor WhatsApp / HP</label>
        <input type="tel" class="form-input" id="customerPhone" name="phone" placeholder="Misal: 081234567890" required />
      </div>

      <div class="form-group">
        <label for="customerAddress">Kota / Alamat Pengiriman</label>
        <input type="text" class="form-input" id="customerAddress" name="address" placeholder="Misal: Cikarang Utara, Bekasi" required />
      </div>

      <div style="display:flex; flex-direction:column; gap:10px; margin-top:8px;">
        <button type="button" class="btn btn-dark" id="btnSubmitWa" style="width:100%; justify-content:center;">
          <span>📲 Pesan Cepat via WhatsApp</span>
          <span class="arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ whatsappNumber }}>
  const modal = document.getElementById('preorderModal');
  const closeBtn = document.getElementById('closePreorderModal');
  const form = document.getElementById('preorderForm');
  const variantSelect = document.getElementById('variantSelect');
  const btnSubmitWa = document.getElementById('btnSubmitWa');

  function openModal(defaultVariant) {
    if (!modal) return;
    if (defaultVariant && variantSelect) {
      for (let i = 0; i < variantSelect.options.length; i++) {
        if (variantSelect.options[i].text.toLowerCase().includes(defaultVariant.toLowerCase())) {
          variantSelect.selectedIndex = i;
          break;
        }
      }
    }
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    modal.style.setProperty('display', 'flex', 'important');
    modal.style.setProperty('opacity', '1', 'important');
    modal.style.setProperty('visibility', 'visible', 'important');
    modal.style.setProperty('pointer-events', 'auto', 'important');
    modal.style.setProperty('z-index', '999999', 'important');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    modal.style.setProperty('display', 'none', 'important');
    modal.style.setProperty('opacity', '0', 'important');
    modal.style.setProperty('visibility', 'hidden', 'important');
    modal.style.setProperty('pointer-events', 'none', 'important');
    document.body.style.overflow = '';
  }

  window.openPreorderModal = openModal;
  window.closePreorderModal = closeModal;

  // Open modal triggers from across the page
  document.querySelectorAll('.open-preorder-modal, .btn-buy, [data-open-preorder]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const tierTitle = btn.getAttribute('data-title') || btn.getAttribute('data-product');
      if (tierTitle || btn.classList.contains('open-preorder-modal') || btn.hasAttribute('data-open-preorder')) {
        e.preventDefault();
        openModal(tierTitle || '');
      }
    });
  });

  // Delegated document click (capture phase) for bulletproof click handling
  document.addEventListener(
    'click',
    (e) => {
      const target = e.target;
      if (!target) return;
      const trigger = target.closest && target.closest('.open-preorder-modal, .btn-buy, [data-open-preorder]');
      if (trigger) {
        e.preventDefault();
        const tierTitle = trigger.getAttribute('data-title') || trigger.getAttribute('data-product');
        openModal(tierTitle || '');
      }
    },
    true
  );

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) closeModal();
  });

  // Submit via WhatsApp
  function submitWa() {
    const nameEl = document.getElementById('customerName');
    const phoneEl = document.getElementById('customerPhone');
    const addressEl = document.getElementById('customerAddress');

    const name = nameEl ? nameEl.value.trim() : '';
    const phone = phoneEl ? phoneEl.value.trim() : '';
    const address = addressEl ? addressEl.value.trim() : '';
    const variant = variantSelect ? variantSelect.value : '';

    if (!name || !phone) {
      alert('Mohon lengkapi nama dan nomor WhatsApp Anda terlebih dahulu.');
      return;
    }

    const text = `Halo tim Xichi AI!\nSaya ingin melakukan pre-order perangkat:\n\n📦 *Varian*: ${variant}\n👤 *Nama*: ${name}\n📞 *No. WA*: ${phone}\n📍 *Kota/Alamat*: ${address || '-'}\n\nMohon info ketersediaan stok & nomor rekening pembayaran. Terima kasih!`;
    const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
    window.open(waUrl, '_blank');
    closeModal();
  }

  btnSubmitWa?.addEventListener('click', (e) => {
    e.preventDefault();
    submitWa();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitWa();
  });
</script>
